# Enemy face. The template shows the art through a window; a subtitled card
# uses its own template.
AHLCG-EnemyFace-template = ArkhamHorrorLCG/templates/AHLCG-Enemy.jp2
AHLCG-EnemyFace-Subtitled-template = ArkhamHorrorLCG/templates/AHLCG-EnemyST.jp2

AHLCG-EnemyFace-Portrait-portrait-template = ArkhamHorrorLCG/default-portraits/DefaultTexture.jp2
AHLCG-EnemyFace-Portrait-portrait-pany = 0
AHLCG-EnemyFace-Portrait-portrait-rotation = 0
AHLCG-EnemyFace-Portrait-portrait-clip-region = -18,223,411,320
AHLCG-EnemyFace-BackPortrait-portrait-template = ArkhamHorrorLCG/default-portraits/DefaultTexture.jp2
AHLCG-EnemyFace-BackPortrait-portrait-pany = 0
AHLCG-EnemyFace-BackPortrait-portrait-rotation = 0
AHLCG-EnemyFace-BackPortrait-portrait-clip-region = -18,223,411,320

AHLCG-EnemyFace-Name-region = 62,5,252,27
# Bigger than standard, but don't want fractional sizes because Teutonic comes out weird
AHLCG-EnemyFace-Name-style = FAMILY: {Eons.namedObjects.AHLCGObject.titleFamily}; SIZE: {Eons.namedObjects.AHLCGObject.titleFontSize}; WEIGHT: {Eons.namedObjects.AHLCGObject.titleFontWeight}; WIDTH: {Eons.namedObjects.AHLCGObject.titleFontWidth*1.05}; TRACKING: {Eons.namedObjects.AHLCGObject.titleFontTracking}; FOREGROUND: #000000
AHLCG-EnemyFace-Subtitle-region = 40,32,293,20
AHLCG-EnemyFace-Subtitle-style = FAMILY: {Eons.namedObjects.AHLCGObject.subtitleFamily}; SIZE: {Eons.namedObjects.AHLCGObject.subtitleSize}; WEIGHT: {Eons.namedObjects.AHLCGObject.subtitleWeight}; WIDTH: {Eons.namedObjects.AHLCGObject.subtitleWidth}; TRACKING: {Eons.namedObjects.AHLCGObject.subtitleTracking}; FOREGROUND: #000000
AHLCG-EnemyFace-Subtitle-alignment = center, middle

