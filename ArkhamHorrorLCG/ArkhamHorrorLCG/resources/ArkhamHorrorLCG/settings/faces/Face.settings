# Defaults for any face without its own value
AHLCG-Face-Body-alignment = left
AHLCG-Face-Body-style = FAMILY: {Eons.namedObjects.AHLCGObject.bodyFamily}; SIZE: {Eons.namedObjects.AHLCGObject.bodyFontSize}; WEIGHT: {Eons.namedObjects.AHLCGObject.bodyFontWeight}; WIDTH: {Eons.namedObjects.AHLCGObject.bodyFontWidth}; TRACKING: {Eons.namedObjects.AHLCGObject.bodyFontTracking}; FOREGROUND: #000000
AHLCG-Face-Body-tightness = 0.6
AHLCG-Face-Header-alignment = left
AHLCG-Face-Header-style = FAMILY: {Eons.namedObjects.AHLCGObject.victoryFamily}; SIZE: {Eons.namedObjects.AHLCGObject.bodyFontSize}; WEIGHT: {Eons.namedObjects.AHLCGObject.bodyVictoryWeight}; WIDTH: {Eons.namedObjects.AHLCGObject.bodyFontWidth}; TRACKING: {Eons.namedObjects.AHLCGObject.bodyFontTracking}; FOREGROUND: #000000
AHLCG-Face-Header-tightness = 0.6
AHLCG-Face-Name-alignment = center, middle
AHLCG-Face-Name-style = FAMILY: {Eons.namedObjects.AHLCGObject.titleFamily}; SIZE: {Eons.namedObjects.AHLCGObject.titleFontSize}; WEIGHT: {Eons.namedObjects.AHLCGObject.titleFontWeight}; WIDTH: {Eons.namedObjects.AHLCGObject.titleFontWidth}; TRACKING: {Eons.namedObjects.AHLCGObject.titleFontTracking}; FOREGROUND: #000000
AHLCG-Face-CollectionNumber-alignment = right, middle
AHLCG-Face-EncounterNumber-alignment = right, middle
# Card portraits for custom icons; each face paints them in its own regions
AHLCG-Face-Collection-portrait-template = ArkhamHorrorLCG/images/empty1x1.png
AHLCG-Face-Collection-portrait-pany = 0
AHLCG-Face-Collection-portrait-rotation = 0
AHLCG-Face-Collection-portrait-clip-region = 268,486,13,13
AHLCG-Face-Encounter-portrait-template = ArkhamHorrorLCG/images/empty1x1.png
AHLCG-Face-Encounter-portrait-pany = 0
AHLCG-Face-Encounter-portrait-rotation = 0
AHLCG-Face-Encounter-portrait-clip-region = 307,33,32,32
AHLCG-Face-Copyright-alignment = left, middle
